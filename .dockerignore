# Only what the Dockerfile copies. Anything else in the context changes the images' context hash,
# so a commit that touches only the stacks, schemas, scripts, docs, or the published package would
# rebuild every image.
*
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!generated/authentik/package.json
!src/model/
!src/syncs/runtime/
!src/syncs/clubspot/
!src/syncs/gsuite/
