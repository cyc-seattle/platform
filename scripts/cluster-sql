# Sourced, not run: connects kubectl to a stack's cluster, and runs SQL on one of its databases.
# Uses a kubeconfig of its own, so it never changes the user's current context.

# Points kubectl at `stack`'s cluster, and sets `namespace` to the stack's namespace.
connect() {
  local stack="$1" outputs cluster region
  outputs="$(gcloud storage cat "gs://${GCP_PROJECT}-pulumi-${stack}/platform/outputs.json")"
  cluster="$(jq -r .cluster <<<"$outputs")"
  region="$(jq -r .region <<<"$outputs")"
  namespace="$(jq -r .namespace <<<"$outputs")"

  KUBECONFIG="$(mktemp)"
  export KUBECONFIG
  trap 'rm -f "$KUBECONFIG"' EXIT
  gcloud container clusters get-credentials "$cluster" --region "$region" --dns-endpoint --quiet
  # Actions' auth step leaves gcloud with no active account, so authenticate as ADC, as Pulumi's
  # Kubernetes provider does. A gcloud login without ADC keeps the plugin's default.
  if [[ -f "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]]; then
    kubectl config set-credentials "$(kubectl config view --minify -o jsonpath='{.users[0].name}')" \
      --exec-arg=--use_application_default_credentials >/dev/null
  fi
}

# Runs SQL on one of the connected stack's databases, as its owner, from a throwaway pod. The SQL
# goes on stdin: Kubernetes expands `$(VAR)` and `$$` in a container's env, command, and args.
sql() {
  local database="$1" statement="$2" overrides
  overrides="$(jq -n --arg secret "${database//_/-}-db" '{
    spec: {
      automountServiceAccountToken: false,
      securityContext: { runAsNonRoot: true, runAsUser: 999, runAsGroup: 999, seccompProfile: { type: "RuntimeDefault" } },
      containers: [{
        name: "sql",
        image: "postgres:16",
        stdin: true,
        stdinOnce: true,
        command: ["sh", "-c", "PGPASSWORD=\"$DB_PASSWORD\" exec psql -v ON_ERROR_STOP=1 -h \"$DB_HOST\" -U \"$DB_USER\" \"$DB_NAME\" -f -"],
        env: [
          { name: "DB_HOST", valueFrom: { secretKeyRef: { name: $secret, key: "host" } } },
          { name: "DB_NAME", valueFrom: { secretKeyRef: { name: $secret, key: "database" } } },
          { name: "DB_USER", valueFrom: { secretKeyRef: { name: $secret, key: "username" } } },
          { name: "DB_PASSWORD", valueFrom: { secretKeyRef: { name: $secret, key: "password" } } }
        ],
        resources: { requests: { cpu: "50m", memory: "64Mi" }, limits: { cpu: "50m", memory: "64Mi" } },
        securityContext: { allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: { drop: ["ALL"] } }
      }]
    }
  }')"
  kubectl run "sql-${database//_/-}-$(date +%s)" --namespace "$namespace" --image postgres:16 --restart Never \
    --rm -i --quiet --overrides "$overrides" <<<"$statement"
}
