#!/usr/bin/env bash
# Puts dev's data back to a fresh start: empties the CRM's collections, reseeds the Clubspot fake,
# empties the Workspace fake, and runs both syncs. Directus keeps its database, schema, roles, and
# users, so it keeps its license activation (cyc-seattle/isthmia#172). Always dev's: prod has no fakes to reseed.
set -euo pipefail

# shellcheck source=scripts/cluster-sql
source "$(dirname "${BASH_SOURCE[0]}")/cluster-sql"
connect dev

# Every table but the ones Parse or Directus keep their own state in.
truncate_all_but() {
  local keep="$1"
  cat <<SQL
DO \$\$
DECLARE tables text;
BEGIN
  SELECT string_agg(format('%I', tablename), ', ') INTO tables
    FROM pg_tables WHERE schemaname = 'public' AND tablename NOT LIKE '$keep';
  IF tables IS NOT NULL THEN EXECUTE 'TRUNCATE ' || tables; END IF;
END
\$\$;
SQL
}

# Runs a CronJob once now and waits for it. kubectl wait watches one condition, so this polls.
run_job() {
  local job
  job="$1-reset-$(date +%s)"
  kubectl create job "$job" --from "cronjob/$1" --namespace "$namespace"
  local conditions=""
  until grep -qwE 'Complete|Failed' <<<"$conditions"; do
    sleep 10
    conditions="$(kubectl get job "$job" --namespace "$namespace" -o jsonpath='{.status.conditions[?(@.status=="True")].type}')"
  done
  kubectl logs "job/$job" --namespace "$namespace" --tail 20 || true
  grep -qw Complete <<<"$conditions"
}

echo "Emptying the CRM's collections"
sql directus "$(truncate_all_but 'directus\_%')"

# The fake seeds an empty database when it starts, and keeps the Workspace fake's state in memory.
echo "Reseeding the fakes"
sql clubspot_fake "$(truncate_all_but '\_SCHEMA')"
kubectl rollout restart deployment/clubspot-fake deployment/workspace-fake --namespace "$namespace"
for fake in clubspot-fake workspace-fake; do
  kubectl rollout status "deployment/$fake" --namespace "$namespace" --timeout 15m
done

echo "Syncing"
run_job clubspot-sync
run_job gsuite-sync
